# Copia este archivo como ".env" (en esta misma carpeta) y cambia los valores. El archivo .env NO se sube a git.

# --- PostgreSQL ---
DB_NAME=sigr
DB_USER=sigr_app
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=pon-aqui-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Solo producción (DJANGO_DEBUG=0). Ver docs/despliegue.md ---
# Dominios con https desde los que se envían formularios, separados por comas.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://sigr.ejemplo.com
# Pon 1 si nginx (u otro proxy) termina el HTTPS y reenvía X-Forwarded-Proto.
# DJANGO_BEHIND_PROXY=1
# Redirigir http a https (1 por defecto) y duración de HSTS en segundos (31536000 por defecto).
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
